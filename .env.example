# Cloud sync (optional).
#
# Leave these unset and the app runs entirely in the browser with local storage,
# exactly as it does today — no account, no network.
#
# To turn on sync and sharing, create a free project at https://supabase.com,
# run supabase/schema.sql in its SQL editor, then copy this file to `.env` and
# fill in the two values from Project Settings -> API.
#
# The anon key is meant to be public — it's safe in a browser build. Row-level
# security in schema.sql is what actually keeps your data private.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
